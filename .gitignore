# ---------------------------------------------------------------
# Secrets and credentials: never commit these
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json

# MCA / browser session data (cookies, storage state, browser profiles)
mca_session/
.mca-profile/
browser-profile*/
playwright/.auth/
*storage_state*.json
*.cookies
cookies*.json

# Runtime storage: uploaded documents, evidence snapshots, generated reports (client data).
# The app keeps all of these under data/.
/data/
/backend/data/
*.pdf
!**/fixtures/**/*.pdf
!docs/**/*.pdf

# Database dumps
*.sql.gz
*.dump
*.backup

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/

# ---------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------
node_modules/
dist/
*.local
*.tsbuildinfo
npm-debug.log*

# ---------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.log
