# Copy this file to .env and adjust values. Never commit .env.
# PowerShell:  Copy-Item .env.example .env

# --- Application ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker-compose.yml) ---
# Change the password for anything beyond local development.
POSTGRES_USER=roc
POSTGRES_PASSWORD=roc_dev_password
POSTGRES_DB=roc_verifier
POSTGRES_PORT=5432

# --- Backend database connection (must match the values above) ---
DATABASE_URL=postgresql+psycopg://roc:roc_dev_password@localhost:5432/roc_verifier

# --- ROC data source ---
# mock = local fixture data, no MCA access. Other providers are added in later phases.
ROC_PROVIDER=mock
